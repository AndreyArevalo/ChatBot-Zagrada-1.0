# ─── API de inteligencia artificial ───────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_EXTRACTOR_MODEL=openai/gpt-4o-mini

# (Opcional) Si usas OpenAI directamente en lugar de OpenRouter
OPENAI_API_KEY=sk-...

# ─── WhatsApp ─────────────────────────────────────────────────────────────────
# Número administrador (con código de país, sin +)
# Ejemplo: 573156191389
ADMIN_WHATSAPP=57XXXXXXXXXX

# JID del grupo de WhatsApp donde llegan las notificaciones de reservas y domicilios
# Formato: 120363XXXXXXXXXX@g.us
# Para obtenerlo: el bot lo imprime en consola cuando recibe un mensaje del grupo
RESERVAS_GROUP_JID=120363XXXXXXXXXX@g.us
